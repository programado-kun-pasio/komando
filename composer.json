{
    "name": "programado/komando",
    "description": "A package filled with programado related laravel utilities.",
    "type": "laravel-package",
    "version": "1.0.2",
    "require": {
        "php": ">=8.4",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "nuwave/lighthouse": "^6.45",
        "spatie/ssh": "^1.13"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Programado\\Komando\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Programado\\Komando\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test src/Files tests src/Providers/KomandoServiceProvider.php config/komando.php",
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "Friedrich Waack",
            "email": "friedrich.waack@programado.de"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Programado\\Komando\\Providers\\KomandoServiceProvider"
            ]
        }
    }
}
