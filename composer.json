{
    "name": "programado/komando",
    "description": "Laravel utilities by programado, including database synchronization and reusable GraphQL file attachments.",
    "keywords": [
        "laravel",
        "lighthouse",
        "graphql",
        "file-attachments",
        "database-sync"
    ],
    "homepage": "https://github.com/programado-kun-pasio/komando",
    "type": "laravel-package",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "laravel/framework": "^13.0",
        "lastdragon-ru/lara-asp-graphql": "^11.2",
        "nuwave/lighthouse": "^6.66",
        "spatie/ssh": "^1.13"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Programado\\Komando\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Programado\\Komando\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test src/ExceptionReporting src/Files tests src/Providers/KomandoServiceProvider.php config/komando.php",
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "Friedrich Waack",
            "email": "friedrich.waack@programado.de"
        }
    ],
    "support": {
        "issues": "https://github.com/programado-kun-pasio/komando/issues",
        "source": "https://github.com/programado-kun-pasio/komando"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Programado\\Komando\\Providers\\KomandoServiceProvider"
            ]
        }
    }
}
